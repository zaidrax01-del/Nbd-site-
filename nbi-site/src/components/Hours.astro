---
import settings from '../data/settings.json';

const steps = [
  { n: '1', title: 'Pick a time', body: 'Use the booking link, or call/text us directly.' },
  { n: '2', title: 'We come to you', body: 'Home, office, apartment — as long as we have access.' },
  { n: '3', title: 'Walkthrough', body: 'We go over the finished work with you before packing up.' },
  { n: '4', title: 'Pay when done', body: 'Card, cash or mobile payment. No deposits required.' },
];
---

<section id="hours">
  <div class="wrap sec split">
    <div>
      <div class="lab">Hours</div>
      <h2 class="serif">When We Work</h2>
      <p class="sub">Mobile appointments, 7 days a week by request.</p>

      <ul class="hours">
        {settings.hours.map((h) => (
          <li>
            <span>{h.label}</span>
            <span class={h.closed ? 'closed' : ''}>{h.value}</span>
          </li>
        ))}
      </ul>

      <p class="note">
        Last appointment starts 2 hours before close. Weather-dependent — we'll reschedule
        free if it rains.
      </p>
    </div>

    <div>
      <div class="lab">How It Works</div>
      <h2 style="font-size:20px">Booking is simple</h2>
      <div class="why">
        {steps.map((s) => (
          <div>
            <i class="step" aria-hidden="true">{s.n}</i>
            <b>{s.title}</b>
            <small>{s.body}</small>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
