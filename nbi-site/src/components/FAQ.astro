 ---
import { getCollection, render } from 'astro:content';

const questions = (await getCollection('faq')).sort(
  (a, b) => a.data.weight - b.data.weight
);

const rendered = await Promise.all(
  questions.map(async (q) => ({
    data: q.data,
    Content: (await render(q)).Content,
  }))
);
---

<section id="faq">
  <div class="wrap sec">
    <div class="lab">FAQ</div>
    <h2 class="serif">Questions, Answered</h2>
    <p class="sub" style="margin-bottom:26px">
      Still not sure? Call or text — we're happy to talk it through.
    </p>

    {rendered.map((q) => (
      <details>
        <summary>{q.data.question}</summary>
        <div class="faq-answer"><q.Content /></div>
      </details>
    ))}
  </div>
</section>
