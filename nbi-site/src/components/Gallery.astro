---
import { getCollection } from 'astro:content';

const photos = (await getCollection('gallery')).sort(
  (a, b) => a.data.weight - b.data.weight
);
---

{photos.length > 0 && (
  <section id="photos">
    <div class="wrap sec">
      <div class="lab">Gallery</div>
      <h2 class="serif">More of Our Work</h2>
      <p class="sub">Interiors, wheels, paint, engine bays — the details matter.</p>

      <div class="gal">
        {photos.map((p) => (
          <figure class={`shot${p.data.featured ? ' featured' : ''}`}>
            <img src={p.data.image} alt={p.data.caption} loading="lazy" decoding="async">
            <figcaption>{p.data.caption}</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>
)}
